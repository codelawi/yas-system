APP_NAME="Equipment Repository"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.1.10

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
